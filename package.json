{
  "name": "polis",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "POLIS (Poster Overlay Layer Integration Service). Self-hosted poster overlays for Aurora and compatible players.",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "bun --bun next dev -p 3050",
    "dev:clean": "rm -rf .next && bun --bun next dev -p 3050",
    "build": "bun --bun next build",
    "build:clean": "rm -rf .next && bun --bun next build",
    "sync:fonts": "sh scripts/sync-overlay-fonts.sh",
    "fetch:fonts": "sh scripts/fetch-overlay-fonts.sh",
    "start": "bun --bun next start -p 3050",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "lucide-react": "^1.67.0",
    "next": "^16.4.5",
    "opentype.js": "^2.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@fontsource/dejavu-sans": "^5.3.0",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/bun": "^1.4.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2"
  }
}
